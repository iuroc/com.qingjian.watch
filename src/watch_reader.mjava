// 手表版阅读：服务端沿用手机分页（1000x2000/fsize18），表上滚动 + 左右按钮翻页
import android.util.Log;
import android.view.Gravity;
import android.view.MotionEvent;
import android.view.View;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.widget.FrameLayout;
import android.widget.TextView;
import org.json.JSONArray;
import org.json.JSONObject;

public void boot() {
    i.fn("qj_core");
    i.fn("qj_store");
    i.fn("watch_ui");
    String item = (String) i.sss("qj.item");
    if (item == null) {
        return;
    }
    layoutReader(item);
    bindButtons();
    load();
}

public int dp(float v) {
    return (int) (v * activity.getResources().getDisplayMetrics().density);
}

public int toInt(Object o, int def) {
    if (o == null) return def;
    if (o instanceof Number) return ((Number) o).intValue();
    try {
        return Integer.parseInt(String.valueOf(o));
    } catch (Throwable t) {
        return def;
    }
}

public void layoutReader(String item) {
    activity.findViewById(3).setVisibility(View.GONE);   // 顶部不再显示书名

    FrameLayout.LayoutParams wlp = new FrameLayout.LayoutParams(dp(165), dp(165));
    wlp.gravity = Gravity.CENTER;
    activity.findViewById(2).setLayoutParams(wlp);

    FrameLayout.LayoutParams tlp = new FrameLayout.LayoutParams(dp(104), -2);
    tlp.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL;
    tlp.topMargin = dp(8);
    activity.findViewById(3).setLayoutParams(tlp);

    FrameLayout.LayoutParams llp = new FrameLayout.LayoutParams(dp(30), dp(60));
    llp.gravity = Gravity.LEFT | Gravity.CENTER_VERTICAL;
    llp.leftMargin = dp(3);
    activity.findViewById(4).setLayoutParams(llp);

    FrameLayout.LayoutParams rlp = new FrameLayout.LayoutParams(dp(30), dp(60));
    rlp.gravity = Gravity.RIGHT | Gravity.CENTER_VERTICAL;
    rlp.rightMargin = dp(3);
    activity.findViewById(5).setLayoutParams(rlp);

    FrameLayout.LayoutParams blp = new FrameLayout.LayoutParams(-2, -2);
    blp.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL;
    blp.bottomMargin = dp(2);
    activity.findViewById(6).setLayoutParams(blp);

    WebView wv = (WebView) activity.findViewById(2);
    wv.setHorizontalScrollBarEnabled(false);
    wv.setVerticalScrollBarEnabled(false);
    wv.setLongClickable(false);
    wv.setHapticFeedbackEnabled(false);
    wv.setOnLongClickListener(new View.OnLongClickListener() {
        public boolean onLongClick(View v) {
            return true;
        }
    });
    WebSettings ws = wv.getSettings();
    ws.setSupportZoom(false);
    ws.setBuiltInZoomControls(false);
    ws.setDisplayZoomControls(false);
    ws.setUseWideViewPort(false);
    ws.setLoadWithOverviewMode(false);
    wv.loadDataWithBaseURL(core_web(), html("<p>载入中…</p>"), "text/html", "utf-8", null);
    bindCrown(wv);
}

public void bindButtons() {
    activity.findViewById(4).setOnClickListener(new View.OnClickListener() {
        public void onClick(View v) {
            page(-1);   // 直接翻页，页内滚动交给表冠/手指
        }
    });
    activity.findViewById(5).setOnClickListener(new View.OnClickListener() {
        public void onClick(View v) {
            page(1);
        }
    });
    activity.findViewById(7).setOnClickListener(new View.OnClickListener() {
        public void onClick(View v) {
            menu();
        }
    });
}

public void menu() {
    Log.i("qjwatch", "menu tap");
    i.uigo("menu.iyu");
}

// 从菜单/目录回来
public void resume() {
    Object g = i.sss("qw.goto");
    String gs = g == null ? "" : String.valueOf(g);
    if (gs.length() > 0 && !"null".equals(gs)) {
        i.sss("qw.goto", "");
        int gp = toInt(g, 0);
        if (gp > 0) {
            i.sss("qw.loading", "0");
            i.sss("qw.idx", Integer.valueOf(gp - 1));
            render();
            return;
        }
    }
    if ("1".equals(i.sss("qw.quit"))) {
        i.sss("qw.quit", "0");
        activity.finish();
        return;
    }
    Object p = i.sss("qw.pending");
    i.sss("qw.pending", "0");
    int d = toInt(p, 0);
    if (d != 0) {
        i.sss("qw.loading", "0");
        page(d);
    }
}

public String html(String frag) {
    return "<html><head><meta name='viewport' content='width=device-width, initial-scale=1.0'>"
        + "<style>html,body{margin:0;padding:0;background:#141218;color:#E6E0E9;overflow-x:hidden;}"
        + "body{padding:2px 1px;font-size:14px;line-height:1.6;-webkit-text-size-adjust:none;"
        + "-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;}"
        + "p{margin:0 0 0.6em 0;text-indent:2em;}"
        + ".text>div{text-align:justify;}"
        + "img{max-width:100%!important;height:auto!important;display:block;margin:6px auto;}"
        + "</style></head><body>" + frag + "</body></html>";
}

public void bindCrown(WebView wv) {
    wv.setOnGenericMotionListener(new View.OnGenericMotionListener() {
        public boolean onGenericMotion(View v, MotionEvent e) {
            if (e.getAction() == MotionEvent.ACTION_SCROLL) {
                crownScroll(e.getAxisValue(MotionEvent.AXIS_VSCROLL));
                return true;
            }
            return false;
        }
    });
}

public void crownScroll(float d) {
    float acc = toFloat(i.sss("qw.acc"), 0.0f) + d;
    if (Math.abs(acc) < 55) {
        i.sss("qw.acc", Float.valueOf(acc));
        return;
    }
    i.sss("qw.acc", Float.valueOf(0.0f));
    nudge(acc > 0 ? -1 : 1);
}

public float toFloat(Object o, float def) {
    if (o instanceof Number) return ((Number) o).floatValue();
    return def;
}

public void nudge(int dir) {
    WebView w = (WebView) activity.findViewById(2);
    if (w == null) return;
    int delta = dp(26);
    if (dir > 0) {
        if (w.canScrollVertically(1)) {
            w.scrollBy(0, delta);
        } else {
            page(1);
        }
    } else {
        if (w.canScrollVertically(-1)) {
            w.scrollBy(0, -delta);
        } else {
            page(-1);
        }
    }
}

public void step(int dir) {
    WebView w = (WebView) activity.findViewById(2);
    if (w == null) return;
    if (dir > 0) {
        if (w.canScrollVertically(1)) {
            w.scrollBy(0, w.getHeight());
        } else {
            page(1);
        }
    } else {
        if (w.canScrollVertically(-1)) {
            w.scrollBy(0, -w.getHeight());
        } else {
            page(-1);
        }
    }
}

public void page(int delta) {
    if ("1".equals(i.sss("qw.loading"))) return;
    long now = System.currentTimeMillis();
    Object o = i.sss("qw.flipT");
    if (o != null && now - ((Number) o).longValue() < 300) return;
    i.sss("qw.flipT", Long.valueOf(now));
    int total = toInt(i.sss("qw.total"), 0);
    if (total <= 0) return;
    int idx = toInt(i.sss("qw.idx"), 0) + delta;
    if (idx < 0) idx = 0;
    if (idx >= total) idx = total - 1;
    i.sss("qw.idx", Integer.valueOf(idx));
    i.sss("qw.loading", "1");
    render();
}

public void load() {
    new Thread(new Runnable() {
        public void run() {
            i.fn("qj_core");
            String item = (String) i.sss("qj.item");
            String surl = "";
            int start = 1;
            try {
                JSONObject o = new JSONObject(item);
                surl = o.optString("surl");
                start = o.optInt("page", 1);
            } catch (Throwable t) {
            }
            HashMap m = core_readPage(surl, 18, 1, 30);
            int total = toInt(m.get("pageAll"), 0);
            if (total <= 0) {
                i.sss("qw.total", Integer.valueOf(0));
                activity.runOnUiThread(new Runnable() {
                    public void run() {
                        fail();
                    }
                });
                return;
            }
            ArrayList list = new ArrayList();
            for (int k = 0; k < total; k++) {
                list.add(null);
            }
            fill(list, m, 0);
            i.sss("qw.list", list);
            i.sss("qw.total", Integer.valueOf(total));
            JSONArray cats = (JSONArray) m.get("catalogs");
            if (cats != null) {
                i.sss("qw.catalogs", cats.toString());
            }
            int idx = start - 1;
            if (idx < 0) idx = 0;
            if (idx >= total) idx = total - 1;
            i.sss("qw.idx", Integer.valueOf(idx));
            activity.runOnUiThread(new Runnable() {
                public void run() {
                    render();
                }
            });
        }
    }).start();
}

public void fill(ArrayList list, HashMap m, int startIdx) {
    try {
        JSONArray arr = (JSONArray) m.get("contents");
        if (arr == null) return;
        for (int k = 0; k < arr.length(); k++) {
            int at = startIdx + k;
            if (at >= 0 && at < list.size()) {
                list.set(at, arr.optString(k));
            }
        }
    } catch (Throwable t) {
        Log.i("qjwatch", "fill fail " + t);
    }
}

public void ensure(int idx) {
    i.fn("qj_core");
    int start = (idx / 30) * 30;
    new Thread(new Runnable() {
        public void run() {
            i.fn("qj_core");
            String item = (String) i.sss("qj.item");
            String surl = "";
            try {
                surl = new JSONObject(item).optString("surl");
            } catch (Throwable t) {
            }
            HashMap m = core_readPage(surl, 18, start + 1, 30);
            ArrayList list = (ArrayList) i.sss("qw.list");
            if (list != null) fill(list, m, start);
            activity.runOnUiThread(new Runnable() {
                public void run() {
                    i.sss("qw.loading", "0");
                    render();
                }
            });
        }
    }).start();
}

public void render() {
    i.fn("qj_core");
    i.fn("qj_store");
    ArrayList list = (ArrayList) i.sss("qw.list");
    int total = toInt(i.sss("qw.total"), 0);
    if (list == null || total <= 0) {
        i.sss("qw.loading", "0");
        return;
    }
    int idx = toInt(i.sss("qw.idx"), 0);
    if (idx < 0) idx = 0;
    if (idx >= total) idx = total - 1;
    ((TextView) activity.findViewById(8)).setText((idx + 1) + " / " + total);
    if (idx >= list.size()) {
        i.sss("qw.loading", "0");
        return;
    }
    String frag = (String) list.get(idx);
    if (frag == null) {
        ensure(idx);
        return;
    }
    WebView wv = (WebView) activity.findViewById(2);
    if (wv == null) {
        i.sss("qw.loading", "0");
        return;
    }
    wv.loadDataWithBaseURL(core_web(), html(frag), "text/html", "utf-8", null);
    wv.scrollTo(0, 0);
    WebView topWv = wv;
    wv.postDelayed(new Runnable() {
        public void run() {
            topWv.scrollTo(0, 0);
        }
    }, 300);
    i.sss("qw.loading", "0");
    try {
        String itemJson = (String) i.sss("qj.item");
        if (itemJson != null) store_saveHistory(itemJson, idx + 1, total);
    } catch (Throwable t) {
    }
}

public void fail() {
    i.fn("qj_core");
    WebView wv = (WebView) activity.findViewById(2);
    if (wv != null) {
        wv.loadDataWithBaseURL(core_web(), html("<p>正文加载失败</p><p>左滑返回重试</p>"), "text/html", "utf-8", null);
    }
}

public void key(String tag, Object kcObj) {
    int kc = toInt(kcObj, -1);
    if (kc == 4) {
        activity.finish();
    }
}
